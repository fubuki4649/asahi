#!/bin/bash

# asahictl - CLI tool for managing system settings
# Usage: asahictl [command] [value]

SCRIPT_NAME="asahictl"
VERSION="1.0.0"

DBUS_DEST="org.freedesktop.impl.portal.desktop.asahi"
DBUS_PATH="/org/freedesktop/portal/desktop"
DBUS_IFACE="org.freedesktop.impl.portal.asahi.Control"

# Function to display help information
show_help() {
    cat << EOF
$SCRIPT_NAME - System Dark Mode CLI Utility

USAGE:
    $SCRIPT_NAME [command] [value]

COMMANDS:
    override [value]              Set or clear manual dark mode override
                                  Values: off, dark, light, nopref
    query [target]                Query daemon state and telemetry
                                  Targets: all, theme, next-transition, location

EXAMPLES:
    $SCRIPT_NAME override off         Disable manual override and determine mode automatically
    $SCRIPT_NAME override dark        Manually force dark mode
    $SCRIPT_NAME override light       Manually force light mode
    $SCRIPT_NAME override nopref      Manually force no system preference
    $SCRIPT_NAME query all            Print a summary of the current live state
    $SCRIPT_NAME query theme          Print the current theme and override status
    $SCRIPT_NAME query next-transition  Print the next expected sunrise/sunset switch
    $SCRIPT_NAME query location       Print the location currently used for calculations

OPTIONS:
  -h, --help                      Show this help message
  -v, --version                   Show version information

EOF
}

# Function to display version
show_version() {
    echo "$SCRIPT_NAME version $VERSION"
}


# Function for manual override
set_override() {
    local value="$1"
    local int_val

    case "$value" in
        "off")    int_val=-1 ;;
        "dark")   int_val=1 ;;
        "light")  int_val=2 ;;
        "nopref") int_val=0 ;;
        "")
            echo "Error: override requires a value (off, dark, light, nopref)" >&2
            return 1
            ;;
        *)
            echo "Error: Invalid value '$value' for override. Valid values are: off, dark, light, nopref" >&2
            return 1
            ;;
    esac

    echo "Setting manual override to: $value"

    dbus-send --session --dest="$DBUS_DEST" \
        --type=method_call "$DBUS_PATH" \
        "$DBUS_IFACE.setManualDarkMode" \
        int32:"$int_val"

    echo "Manual override successfully set to $value"
}

# Queries a single property on the Control D-Bus interface.
# Prints the raw dbus-send output (or error text) and returns its exit status.
_dbus_get_property() {
    local prop="$1"
    dbus-send --session --print-reply --dest="$DBUS_DEST" \
        --type=method_call "$DBUS_PATH" \
        org.freedesktop.DBus.Properties.Get \
        string:"$DBUS_IFACE" string:"$prop" 2>&1
}

# Queries the currentTheme and isOverrideSet properties
query_theme() {
    local theme_reply override_reply theme_val is_override theme_name override_str

    if ! theme_reply=$(_dbus_get_property "currentTheme"); then
        echo "Error: Failed to query currentTheme: $theme_reply" >&2
        return 1
    fi
    theme_val=$(echo "$theme_reply" | awk '/variant/ {print $NF}')

    case "$theme_val" in
        0) theme_name="No Preference" ;;
        1) theme_name="Dark Mode" ;;
        2) theme_name="Light Mode" ;;
        *) theme_name="Unknown ($theme_val)" ;;
    esac

    if ! override_reply=$(_dbus_get_property "isOverrideSet"); then
        echo "Error: Failed to query isOverrideSet: $override_reply" >&2
        return 1
    fi
    is_override=$(echo "$override_reply" | awk '/variant/ {print $NF}')

    if [ "$is_override" = "true" ]; then
        override_str="override set"
    else
        override_str="automatic"
    fi

    echo "Theme: $theme_name ($override_str)"
}

# Queries the nextTransitionAt property (ISO 8601 timestamp of the next sunrise/sunset switch)
query_next_transition() {
    local reply value
    if ! reply=$(_dbus_get_property "nextTransitionAt"); then
        echo "Error: Failed to query nextTransitionAt: $reply" >&2
        return 1
    fi
    value=$(echo "$reply" | sed -n 's/.*string "\(.*\)".*/\1/p')

    echo "Next transition at: $value"
}

# Queries the location property (lat/lon currently used for sunrise/sunset calculations)
query_location() {
    local reply lat lon
    if ! reply=$(_dbus_get_property "location"); then
        echo "Error: Failed to query location: $reply" >&2
        return 1
    fi
    lat=$(echo "$reply" | awk '/double/ {print $2}' | sed -n '1p')
    lon=$(echo "$reply" | awk '/double/ {print $2}' | sed -n '2p')

    echo "Location: lat=$lat, lon=$lon"
}

# Prints a combined summary of all query targets
query_all() {
    query_theme || return 1
    query_next_transition || return 1
    query_location || return 1
}

# Dispatcher for query command
query_daemon() {
    local target="$1"

    case "$target" in
        "all")
            query_all
            ;;
        "theme")
            query_theme
            ;;
        "next-transition")
            query_next_transition
            ;;
        "location")
            query_location
            ;;
        "")
            echo "Error: query requires a target (all, theme, next-transition, location)" >&2
            return 1
            ;;
        *)
            echo "Error: Invalid target '$target' for query. Valid targets are: all, theme, next-transition, location" >&2
            return 1
            ;;
    esac
}

# Main logic
main() {
    # Handle special flags first
    case "$1" in
        "-h"|"--help"|"help")
            show_help
            exit 0
            ;;
        "-v"|"--version"|"version")
            show_version
            exit 0
            ;;
    esac

    # Handle commands
    case "$1" in
        "override")
            set_override "$2"
            exit $?
            ;;
        "query")
            query_daemon "$2"
            exit $?
            ;;
        "")
            # No arguments provided - show help
            echo "Error: No command specified" >&2
            echo
            show_help
            exit 1
            ;;
        *)
            # Unknown command - show help
            echo "Error: Unknown command '$1'" >&2
            echo
            show_help
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"